# Postgres connection string. For local development, run `npx prisma dev`
# and copy the URL it prints. For production, use a hosted Postgres
# connection string (e.g. Neon, Vercel Postgres, Prisma Postgres).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Production (Neon) only — the direct/unpooled connection string, used only
# by `npm run vercel-build`'s `prisma migrate deploy` step (pooled
# connections like PgBouncer don't reliably support the advisory locks
# Prisma's migration engine uses). Vercel's Neon integration adds this
# automatically; not needed locally, where there's only one connection.
# DATABASE_URL_UNPOOLED="postgres://..."

# Admin login (Stage D — simple shared-password gate, no user accounts yet).
# Set strong unique values before deploying.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-too"

# Client Portal session signing — must be a different value from
# ADMIN_SESSION_SECRET (admin and client sessions are intentionally never
# interchangeable). Set a strong unique value before deploying.
CLIENT_SESSION_SECRET="change-me-as-well"

# CMS Phase 1 (lib/admin/identity-session.ts) — the new individual-admin
# identity system's own session secret, deliberately separate from
# ADMIN_SESSION_SECRET above. NOT YET WIRED IN to login/proxy/dashboard; see
# SETUP.md ("CMS Phase 1") for the cutover sequence. Set a strong unique
# value before this system is ever wired in and deployed.
ADMIN_IDENTITY_SESSION_SECRET="change-me-too-please"

# Used to build every link inside an outgoing email (verification, invite,
# password reset) — never derived from request headers or hard-coded to
# localhost. Set to the real production domain before deploying.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email provider. Without any of these set, emails are written as readable
# .html files to .local-emails/ instead of being sent — this is the default
# for local development and never sends anything over the network.
#
# Option A — Resend (needs a verified domain you control; cannot send "from"
# a @gmail.com address, since nobody can verify domain ownership of
# gmail.com itself):
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM_ADDRESS="Moira Events <bookings@your-verified-domain.com>"
#
# Option B — Gmail SMTP, sending genuinely from moiraevents27@gmail.com.
# GMAIL_APP_PASSWORD is NOT the account's login password — generate a
# 16-character "App Password" at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on first). Capped at roughly
# 500 messages/day by Gmail itself; fine for this app's current scale.
# GMAIL_USER="moiraevents27@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# EMAIL_FROM_ADDRESS="Moira Events <moiraevents27@gmail.com>"
#
# If both Option A and Option B are set, Resend takes precedence.

# Online payments (Stage N). Flutterwave issues separate TEST and LIVE key
# pairs — never mix them, same "never interchangeable" discipline as
# ADMIN_SESSION_SECRET vs CLIENT_SESSION_SECRET above. Without
# FLUTTERWAVE_SECRET_KEY, a working mock payment provider is used instead —
# in any environment EXCEPT production, where online payments refuse to
# initiate at all rather than silently using the mock.
# FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# A long random string you choose yourself — set the identical value in the
# Flutterwave dashboard under Settings -> Webhooks.
# FLUTTERWAVE_SECRET_HASH="choose-a-long-random-string"
