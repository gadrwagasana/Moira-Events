// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Stage A/B — Wedding information architecture & service catalogue
// Admin-configurable; replaces the previously hardcoded content in
// lib/content/divisions.ts for the Weddings division only.
// =============================================================================

model WeddingType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events   Event[]
  packages Package[]
  bookings Booking[]

  @@index([isActive, sortOrder])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@index([isActive, sortOrder])
}

enum Division {
  WEDDING
  PARTY
  CORPORATE
}

model Service {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  division         Division         @default(WEDDING)
  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id])
  isIncluded       Boolean          @default(true)
  isAddOn          Boolean          @default(false)
  isActive         Boolean          @default(true)
  // Shown publicly when isActive = false (e.g. "Not currently offered")
  inactiveNote     String?
  isFeatured       Boolean          @default(false)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  enquiryServices EnquiryService[]
  quoteItems      QuoteItem[]
  bookingServices BookingService[]
  invoiceItems    InvoiceItem[]

  @@index([division, isActive, sortOrder])
}

// Defined per the owner's data-model request; not surfaced in the UI until
// Moira Events confirms real packages, pricing, and inclusions.
enum PricingType {
  FIXED
  STARTING_FROM
  CUSTOM_QUOTE
  PER_SERVICE
  PER_GUEST
  TBD
}

model Package {
  id            String       @id @default(cuid())
  name          String
  description   String?
  weddingTypeId String?
  weddingType   WeddingType? @relation(fields: [weddingTypeId], references: [id])
  pricingType   PricingType  @default(CUSTOM_QUOTE)
  price         Decimal?
  currency      String?
  minimumGuests Int?
  isActive      Boolean      @default(false)
  isFeatured    Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// =============================================================================
// Stage C/D — Clients, events, and wedding enquiries
// =============================================================================

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

model Client {
  id                     String         @id @default(cuid())
  fullName               String
  email                  String         @unique
  phone                  String?
  whatsapp               String?
  preferredContactMethod ContactMethod?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Client Portal authentication — separate from and never reused by admin
  // auth. passwordHash presence is the account's existence/status; no
  // Client row gets one just by being created via an enquiry/consultation.
  passwordHash  String?
  passwordSetAt DateTime?
  lastLoginAt   DateTime?

  // Admin-generated invite link. Hashed at rest (Stage K.5 §8/§11) — the raw
  // token only ever exists transiently at generation time, shown to admin
  // exactly once; it is never stored or re-displayable afterward. Doubles as
  // the password-reset mechanism when regenerated.
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?

  // Set on successful invite-activation OR public self-registration
  // verification — both are equally valid proof the account's owner
  // controls this email address. Login is blocked while null (§7/§13).
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?

  // Profile email-change re-verification (§19) — the login email never
  // changes until the NEW address is confirmed via the same verification
  // mechanism above, so a mistyped new email can't lock the client out.
  pendingEmail String?

  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  events           Event[]
  enquiries        Enquiry[]
  consultations    Consultation[]
  bookings         Booking[]
  planningRequests PlanningRequest[]
}

enum EventType {
  WEDDING
  PARTY
  CORPORATE
  // No real event — used for general Contact-page messages so they still
  // show up in the same admin enquiry list as everything else.
  GENERAL
}

model Event {
  id                String       @id @default(cuid())
  clientId          String
  client            Client       @relation(fields: [clientId], references: [id])
  type              EventType    @default(WEDDING)
  weddingTypeId     String?
  weddingType       WeddingType? @relation(fields: [weddingTypeId], references: [id])
  // Free-text category for Party/Corporate (e.g. "Birthday", "Conference"),
  // sourced from the existing static category lists — not a new table since
  // those groupings were never meant to be admin-managed like wedding types.
  eventSubtype      String?
  eventDate         DateTime?
  location          String?
  ceremonyLocation  String?
  receptionLocation String?
  estimatedGuests   Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  enquiries Enquiry[]
  bookings  Booking[]
}

enum EnquiryStatus {
  NEW
  UNDER_REVIEW
  CONSULTATION
  QUOTE_PREPARATION
  QUOTE_SENT
  CLIENT_REVIEW
  APPROVED
  BOOKED
  IN_PLANNING
  COMPLETED
  CANCELLED
  DECLINED
}

model Enquiry {
  id                String        @id @default(cuid())
  referenceNumber   String        @unique
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  eventId           String
  event             Event         @relation(fields: [eventId], references: [id])
  status            EnquiryStatus @default(NEW)
  budgetAmount      Decimal?
  budgetCurrency    String?
  otherServicesNote String?
  message           String?
  submittedAt       DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  services EnquiryService[]
  quotes   Quote[]

  @@index([status, submittedAt])
}

model EnquiryService {
  id        String  @id @default(cuid())
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([enquiryId, serviceId])
}

// =============================================================================
// Stages E–H — Quote, booking, payment, invoicing, consultation, communication
// Schema reserved now per the owner's explicit data-model request (prompt §17)
// so later stages are additive migrations, not a redesign. No Server
// Actions/UI are built against these yet; all commercial fields stay
// nullable — no invented prices, deposits, or policies.
// =============================================================================

enum QuoteStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT
  REVISION_REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  enquiryId   String
  enquiry     Enquiry     @relation(fields: [enquiryId], references: [id])
  status      QuoteStatus @default(DRAFT)
  // Minimum-viable versioning (§14): one row per quote, an incrementing
  // version number, and an append-only QuoteRevision history log below —
  // not full quote-cloning, which would be over-engineering for this stage.
  version     Int         @default(1)
  currency    String?

  // Visible only to Moira Events staff vs. visible to the client on a future
  // client-facing quote page — kept as separate columns so that boundary is
  // enforced at the data level, not just in UI conditionals.
  clientNotes   String?
  internalNotes String?
  terms         String?

  issueDate DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  // Recomputed server-side from line items + discount/tax on every edit —
  // never a hardcoded rate or invented default (§5, §6).
  subtotal       Decimal?
  discountAmount Decimal?
  discountNote   String?
  taxAmount      Decimal?
  taxNote        String?
  totalAmount    Decimal?

  acceptedAt DateTime?
  acceptedBy String?

  declinedAt    DateTime?
  declinedBy    String?
  declineReason String?

  revisionRequestedAt DateTime?
  revisionRequestNote String?

  items     QuoteItem[]
  revisions QuoteRevision[]
  // One-to-one: Booking.quoteId is @unique (Stage F §20 — the DB itself
  // prevents a second booking from referencing the same accepted quote).
  booking   Booking?
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  description String
  quantity    Int?     @default(1)
  // Free text ("flat fee", "per guest", "per day") — no fixed vocabulary is
  // confirmed, so this stays a plain field rather than an enum.
  unit        String?
  unitPrice   Decimal?
  total       Decimal?
  notes       String?
  sortOrder   Int      @default(0)
}

model QuoteRevision {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  versionNumber Int
  requestedNote String?
  // Free text ("admin", "client via phone", a name) — no user-accounts
  // system exists yet to reference a real actor.
  changedBy     String?
  snapshot      Json?
  createdAt     DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PLANNING
  READY
  COMPLETED
  CANCELLED
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  status        BookingStatus @default(PENDING)

  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id])
  // One-to-one — the database itself prevents a second booking from being
  // created against the same accepted quote (Stage F §20).
  quoteId  String? @unique
  quote    Quote?  @relation(fields: [quoteId], references: [id])

  // Snapshot of the agreed commercial state at booking time — duplicated
  // from Event/Quote on purpose, not read live, so later edits to the
  // service catalogue, Event, or Quote can't retroactively change what was
  // actually agreed (Stage F §7, §13). See BookingService below for the
  // line-item equivalent.
  acceptedQuoteVersion Int?
  eventDate            DateTime?
  location             String?
  estimatedGuests      Int?
  weddingTypeId        String?
  weddingType          WeddingType? @relation(fields: [weddingTypeId], references: [id])
  agreedTotal          Decimal?
  currency             String?

  // "Planning Information" placeholder (§9) — tasks/timeline/vendors/
  // documents are a future stage; just two note fields for now.
  planningNotes String?
  internalNotes String?

  // Free text ("admin") — no multi-admin identity system exists yet, same
  // placeholder pattern used for QuoteRevision.changedBy.
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services      BookingService[]
  statusHistory BookingStatusHistory[]
  payments      Payment[]
  invoices      Invoice[]

  // Stage J — Event Planning & Collaboration. Named to not collide with the
  // free-text planningNotes/internalNotes columns above (Stage F), which
  // stay untouched.
  timelineItems         EventTimelineItem[]
  tasks                 Task[]
  vendorRecommendations BookingVendorRecommendation[]
  planningNoteEntries   PlanningNote[]
  planningRequests      PlanningRequest[]

  // Stage P — added after a production-readiness audit found these exact
  // columns queried without a supporting index by the admin bookings list
  // (status, createdAt), the same-date warning check and Stage O's upcoming-
  // events report (eventDate + status), and Stage O's financial report
  // (createdAt + status), all hit on every page load/report render.
  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
}

model BookingService {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  description String
  quantity    Int?     @default(1)
  unit        String?
  unitPrice   Decimal?
  total       Decimal?
  sortOrder   Int      @default(0)
}

model BookingStatusHistory {
  id             String         @id @default(cuid())
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  previousStatus BookingStatus?
  newStatus      BookingStatus
  changedBy      String?
  note           String?
  createdAt      DateTime       @default(now())
}

enum PaymentType {
  DEPOSIT
  PARTIAL
  FINAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id])
  // Stage N — set only for online (Flutterwave) payments, tying the ledger
  // entry to the specific invoice the client paid. Existing manual payments
  // stay null (booking-level only), exactly as before this stage.
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  // Free text ("Bank Transfer", "Mobile Money", "Cash"...) — examples only,
  // never presented as confirmed Moira Events payment methods until the
  // owner confirms them (Stage G §5). Same for `type` below (§6).
  type        PaymentType?
  amount      Decimal
  currency    String?
  method      String?
  reference   String?
  status      PaymentStatus @default(PENDING)
  // A payment can have a recorded date while still PENDING/PROCESSING, not
  // only once confirmed PAID — renamed from the placeholder's `paidAt`.
  paymentDate DateTime?
  notes       String?

  // Refund architecture only (§10) — never auto-calculated or auto-applied;
  // admin enters these manually when setting REFUNDED/PARTIALLY_REFUNDED.
  refundAmount    Decimal?
  refundDate      DateTime?
  refundReference String?
  refundReason    String?

  // Gateway-readiness (§22–§24), now wired up in Stage N.
  // providerTransactionId is the idempotency key a webhook checks.
  provider              String?
  providerTransactionId String? @unique
  providerEventId       String?

  // Free text ("admin"/"system") — no multi-admin identity system exists
  // yet, same placeholder pattern used elsewhere (QuoteRevision.changedBy,
  // etc.). Stage N's webhook/return-page writes use "system".
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory PaymentStatusHistory[]

  @@index([bookingId])
  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
  // Stage P — the admin payments list and Stage O's financial report both
  // order/filter by createdAt without this.
  @@index([createdAt])
  @@index([reference])
  // Stage N also adds two PARTIAL unique indexes not expressible in Prisma's
  // schema DSL — hand-added directly to the migration SQL, not here:
  //   Payment_online_reference_key:   UNIQUE(reference)  WHERE provider IS NOT NULL
  //   Payment_one_inflight_per_invoice: UNIQUE(invoiceId) WHERE status IN ('PENDING','PROCESSING') AND provider IS NOT NULL
  // A future `prisma migrate diff` run will NOT know about these — preserve
  // them by hand if the migration history is ever regenerated from scratch.
}

model PaymentStatusHistory {
  id             String         @id @default(cuid())
  paymentId      String
  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  previousStatus PaymentStatus?
  newStatus      PaymentStatus
  changedBy      String?
  note           String?
  createdAt      DateTime       @default(now())
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)

  issueDate DateTime?
  dueDate   DateTime?
  currency  String?

  // Recomputed server-side from line items + discount/tax on every edit —
  // never a hardcoded rate (Stage H §12), same approach as Quote.
  subtotal Decimal?
  discount Decimal?
  tax      Decimal?
  total    Decimal?

  // Visible only to Moira Events staff vs. visible to the client on a future
  // client-facing invoice page — same split already established on Quote.
  clientNotes   String?
  internalNotes String?
  terms         String?

  // Free text ("admin") — no multi-admin identity system exists yet, same
  // placeholder pattern used elsewhere (QuoteRevision.changedBy, etc.).
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         InvoiceItem[]
  statusHistory InvoiceStatusHistory[]
  // Stage N — only online payments set Payment.invoiceId; existing manual
  // payments stay booking-scoped (null), unchanged.
  payments      Payment[]

  // Stage P — added after a production-readiness audit found the admin
  // invoices list (status, createdAt) and its Booking join (bookingId)
  // queried without a supporting index.
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Traceability only — never read live for pricing. Items are snapshotted
  // from Booking.services (itself already a frozen snapshot), not from the
  // live Service catalogue (Stage H §7).
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  description String
  quantity    Int?     @default(1)
  unitPrice   Decimal?
  lineTotal   Decimal?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model InvoiceStatusHistory {
  id             String         @id @default(cuid())
  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  previousStatus InvoiceStatus?
  newStatus      InvoiceStatus
  changedBy      String?
  note           String?
  createdAt      DateTime       @default(now())
}

enum ConsultationMethod {
  IN_PERSON
  PHONE
  WHATSAPP
  VIDEO_CALL
}

enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Consultation {
  id              String              @id @default(cuid())
  referenceNumber String              @unique
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  eventType       EventType?
  // What the client originally asked for — never overwritten by admin.
  preferredDate   DateTime?
  // What admin actually confirmed/rescheduled to — separate from
  // preferredDate so the original request stays visible (same snapshot
  // philosophy used for Quote/Booking/Invoice elsewhere in this schema).
  scheduledDate   DateTime?
  method          ConsultationMethod?
  notes           String?
  status          ConsultationStatus  @default(REQUESTED)
  createdAt       DateTime            @default(now())

  statusHistory ConsultationStatusHistory[]
}

model ConsultationStatusHistory {
  id             String              @id @default(cuid())
  consultationId String
  consultation   Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  previousStatus ConsultationStatus?
  newStatus      ConsultationStatus
  changedBy      String?
  note           String?
  createdAt      DateTime            @default(now())
}

model Communication {
  id        String   @id @default(cuid())
  enquiryId String?
  channel   String?
  message   String
  createdAt DateTime @default(now())
}

// =============================================================================
// Stage J — Event Planning & Collaboration. All five models below are purely
// additive operational data hanging off Booking.id — none of them are ever
// read or written by any commercial calculation (Quote/Booking.agreedTotal/
// Invoice/Payment totals stay untouched by this stage). No *StatusHistory
// table per entity (unlike the financial/commercial records in Stages F–H) —
// createdBy/updatedBy/updatedAt on the row itself is the traceability level
// for operational planning data; see SETUP.md for the full rationale.
// =============================================================================

enum EventTimelineStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model EventTimelineItem {
  id            String              @id @default(cuid())
  bookingId     String
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  // Carries both date and time-of-day — same naive-timestamp convention as
  // every other DateTime in this schema (no timezone column introduced).
  date          DateTime?
  // Free text, not an enum — staff can type anything; the UI offers
  // suggestions (Planning/Meeting/Vendor/Venue/Rehearsal/Event Day/Other)
  // via a <datalist>, not a hard-coded taxonomy (§7).
  type          String?
  status        EventTimelineStatus @default(PLANNED)
  sortOrder     Int                 @default(0)
  clientVisible Boolean             @default(false)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([bookingId])
  @@index([date])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id            String       @id @default(cuid())
  bookingId     String
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?
  // Free text — no staff-identity/user-accounts system exists yet (§13);
  // designed so a real assignee relation can be added later without
  // reshaping this field.
  assignedTo    String?
  clientVisible Boolean      @default(false)
  // Set/cleared automatically alongside status by the same action that
  // changes status — not a separately invented policy.
  completedAt   DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([dueDate])
}

// Moira Events recommends vendors — it does not contract, confirm, pay, or
// otherwise manage a commercial vendor engagement (explicit business rule).
// There is deliberately NO status field anywhere in this pair of models: no
// CONFIRMED/BOOKED/CONTRACTED/PAID, nothing that could imply Moira manages
// the vendor relationship. A recommendation is just: catalogue entry +
// optional per-booking service note + visibility flag.
model VendorRecommendation {
  id          String   @id @default(cuid())
  name        String
  // Free text, not an enum — same rationale as EventTimelineItem.type (§11/§19).
  category    String?
  description String?
  contactName String?
  email       String?
  phone       String?
  website     String?
  address     String?
  // Internal only — never returned by any client-facing loader.
  notes       String?
  // Archive instead of hard-delete once linked to historical bookings
  // (§13/§21) — no delete action is built, only this toggle.
  active      Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingRecommendations BookingVendorRecommendation[]
}

model BookingVendorRecommendation {
  id                     String               @id @default(cuid())
  bookingId              String
  booking                Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorRecommendationId String
  vendorRecommendation   VendorRecommendation @relation(fields: [vendorRecommendationId], references: [id])
  serviceDescription     String?
  // Internal only — never returned by any client-facing loader.
  notes                  String?
  clientVisible          Boolean              @default(false)
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([bookingId])
  @@index([vendorRecommendationId])
}

// Append-only log, same spirit as Communication above — no edit action, only
// create/delete. Client visibility defaults to false (§21).
model PlanningNote {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  content       String
  clientVisible Boolean  @default(false)
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

// =============================================================================
// Stage K — Client Collaboration & Planning Requests. A client request is
// data, not an instruction: creating/responding-to/resolving one NEVER
// touches Booking/Quote/Invoice/Payment fields — those only ever change via
// their own explicit admin actions, same discipline as every other stage.
// =============================================================================

enum PlanningRequestStatus {
  OPEN
  IN_REVIEW
  RESPONDED
  RESOLVED
  CANCELLED
}

model PlanningRequest {
  id        String                @id @default(cuid())
  bookingId String
  booking   Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client                @relation(fields: [clientId], references: [id])
  subject   String
  message   String
  status    PlanningRequestStatus @default(OPEN)
  // Reuses TaskPriority (LOW/MEDIUM/HIGH) rather than a duplicate enum.
  priority  TaskPriority          @default(MEDIUM)
  createdBy String?
  updatedBy String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  messages PlanningRequestMessage[]

  @@index([bookingId])
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum PlanningRequestSenderType {
  CLIENT
  STAFF
}

// The request's own subject/message IS the opening thread entry — never
// duplicated into a row here. This table holds only the back-and-forth that
// follows.
model PlanningRequestMessage {
  id                String                    @id @default(cuid())
  planningRequestId String
  planningRequest   PlanningRequest           @relation(fields: [planningRequestId], references: [id], onDelete: Cascade)
  senderType        PlanningRequestSenderType
  message           String
  createdBy         String?
  createdAt         DateTime                  @default(now())

  @@index([planningRequestId])
}

// =============================================================================
// Stage L2 — Email notifications & secure document delivery
// Tracks exactly the email types that need duplicate-send protection (an
// admin-triggered resend of a business document). EMAIL_VERIFICATION and
// PASSWORD_RESET are deliberately NOT tracked here — those already have
// their own single-use/expiring-token semantics and existing rate-limiting
// (lib/rate-limit.ts), and their tokens rotate per request by design, so a
// durable idempotency key would need the same per-render trick for no real
// benefit. They keep calling sendEmail directly.
// =============================================================================

enum EmailType {
  CLIENT_INVITATION
  QUOTE_ISSUED
  BOOKING_CONFIRMATION
  INVOICE_ISSUED
  PLANNING_RESPONSE
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// idempotencyKey is the actual duplicate-prevention mechanism (a fresh
// per-render requestId embedded by the caller) — not the existence check
// alone, which would be a check-then-act race under a double-click. Callers
// attempt the create() directly and catch the unique-constraint violation,
// same pattern already used for quote/invoice/booking reference numbers.
model EmailDelivery {
  id                   String              @id @default(cuid())
  type                 EmailType
  recipientEmail       String
  relatedRecordType    String?
  relatedRecordId      String?
  relatedRecordVersion Int?
  idempotencyKey       String              @unique
  status               EmailDeliveryStatus @default(PENDING)
  providerMessageId    String?
  attemptCount         Int                 @default(0)
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([relatedRecordType, relatedRecordId])
  @@index([status])
}

// =============================================================================
// Stage M — Document registry & audit trail
// Metadata-only (no PDF bytes stored — Stage L1's on-demand regeneration
// already works and there's no clear reason to duplicate that here).
// Never updated/deleted anywhere in the codebase — audit immutability is an
// APPLICATION-level guarantee only, not enforced by Postgres itself.
// =============================================================================

enum AuditActorType {
  ADMIN
  CLIENT
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

// action/entityType values come from a closed literal-union list
// (lib/audit/constants.ts), not free text — keeps "filter by action"
// actually reliable across ~15+ call sites.
model AuditEvent {
  id            String         @id @default(cuid())
  actorType     AuditActorType
  // "admin" (the one shared staff account — no multi-admin identity system
  // exists in this app) | a real Client.id | "system".
  actorId       String
  action        String
  entityType    String
  entityId      String
  outcome       AuditOutcome
  // Links to e.g. an EmailDelivery.id, or the related business-record id —
  // never duplicates that record's own state.
  correlationId String?
  // Short, hand-composed by the call site — never a raw pass-through of a
  // form field (which could carry a payment reference or similar).
  summary       String
  // Enum-like status values only (e.g. "DRAFT" -> "ISSUED"), never free text.
  beforeValue   String?
  afterValue    String?
  createdAt     DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
}

enum DocumentType {
  QUOTE
  INVOICE
  BOOKING_CONFIRMATION
}

// No `status` field this stage: every PDF route is a synchronous
// render-then-respond in one request, so there is no code path that
// produces a "generated but not yet downloaded" state — GENERATED vs
// DOWNLOADED would always be the same value. Will be reintroduced
// (STORED/STORAGE_FAILED) once Phase-C-style persistent storage actually
// makes generation and retrieval separate moments.
model DocumentRecord {
  id              String         @id @default(cuid())
  type            DocumentType
  relatedRecordId String
  // The quote/invoice/booking's own MQ-/MI-/MB- number, duplicated here for
  // fast lookup without a join.
  referenceNumber String
  version         Int?
  filename        String
  mimeType        String         @default("application/pdf")
  // Always computed from the already-rendered buffer at zero extra cost —
  // the one piece of real forensic value a metadata-only registry offers.
  fileSizeBytes   Int
  checksumSha256  String
  // Null until a real persistent storage provider is configured (Phase C
  // of this stage only defines the seam, lib/documents/storage.ts).
  storageProvider String?
  storageKey      String?
  actorType       AuditActorType
  actorId         String
  createdAt       DateTime       @default(now())

  @@index([type, relatedRecordId])
  @@index([createdAt])
}

// =============================================================================
// CMS Phase 1 — Admin identity + CMS data model (additive, NOT YET WIRED IN).
//
// This stage replaces the single shared ADMIN_PASSWORD env var with real
// individual administrator accounts (role: ADMIN | EDITOR), and lays the CMS
// data model on top. IMPORTANT: no migration for any of what follows has
// been applied (or even diffed against a live database) — `proxy.ts`,
// `app/admin/login/actions.ts`, `lib/admin/session.ts`, and
// `app/admin/(dashboard)/layout.tsx` are all unchanged and still run the old
// shared-password system exactly as before. See SETUP.md ("CMS Phase 1") for
// the exact cutover sequence required before any of this becomes live.
// =============================================================================

enum AdminRole {
  ADMIN
  EDITOR
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cmsPages        CmsPage[]
  blogPosts       BlogPost[]
  mediaAssets     MediaAsset[]
  siteImageSlots  SiteImageSlot[]
  portfolioItems  PortfolioItem[]
  settingsUpdates SiteSettings[]
  testimonials    Testimonial[]
  siteCopyUpdates SiteCopy[]
}

enum CmsContentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model CmsPage {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  metaDescription String?
  ogImageId       String?
  // First Restrict (not SetNull, Prisma's default for a nullable FK) in
  // this schema — deliberate: media still referenced by a published page's
  // OG image must not be deletable out from under it.
  ogImage         MediaAsset?      @relation(fields: [ogImageId], references: [id], onDelete: Restrict)
  // Marks one of the fixed, pre-existing public pages (Home, About,
  // Services, etc.) once migrated into the CMS — enforced in
  // lib/cms/actions.ts: slug changes are rejected for a system page (the
  // route it renders is a real, linked-to Next.js route, not a freeform
  // [slug] catch-all match), and it's excluded from any future page-delete
  // action. Also used for the seeded Privacy Policy / Terms & Conditions
  // legal pages, for the same "slug must not drift" reason.
  isSystemPage    Boolean          @default(false)
  // Per-page SEO override — excluded from indexing without being
  // unpublished (e.g. a page you want reachable but not search-ranked).
  noindex         Boolean          @default(false)
  status          CmsContentStatus @default(DRAFT)
  publishedAt     DateTime?
  // Free text ("admin") is NOT used here, unlike every pre-CMS model —
  // Admin identity now exists, so this is a real FK, not a placeholder
  // string. Nullable because content predating any author assignment (or
  // created by a since-disabled account) must not become unrenderable.
  authorId        String?
  author          Admin?           @relation(fields: [authorId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sections        CmsPageSection[]
  navigationItems NavigationItem[]

  @@index([status])
}

model CmsPageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Free-text block-type discriminator (e.g. "richtext", "hero",
  // "imageGrid") — the renderer's allow-list, not this column, is what
  // actually constrains what can execute (components/cms/RichTextRenderer.tsx).
  type      String
  sortOrder Int      @default(0)
  // Structured block content (Tiptap JSON for richtext blocks, plain JSON
  // for others) — Json columns are already precedented in this schema
  // (QuoteRevision.snapshot), not a new capability being introduced here.
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

model BlogPost {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  excerpt         String?
  // Tiptap JSON output — rendered only through
  // components/cms/RichTextRenderer.tsx's strict allow-list, never
  // dangerouslySetInnerHTML on raw HTML.
  bodyRichText    Json
  featuredMediaId String?
  featuredMedia   MediaAsset?      @relation(fields: [featuredMediaId], references: [id], onDelete: Restrict)
  seoTitle        String?
  seoDescription  String?
  noindex         Boolean          @default(false)
  status          CmsContentStatus @default(DRAFT)
  publishedAt     DateTime?
  authorId        String?
  author          Admin?           @relation(fields: [authorId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
}

// No BlogCategory model this phase (owner-approved deferral) and no
// CmsPageRevision/BlogPostRevision model (owner-approved deferral) — a flat
// post list and no edit-history/rollback, by explicit decision, not
// oversight.

model MediaAsset {
  id              String    @id @default(cuid())
  // "vercel-blob" once wired up (lib/media/provider.ts) — a free-text
  // column, same pattern as Payment.provider, so swapping providers later
  // never requires a schema change.
  storageProvider String
  storageKey      String
  url             String
  altText         String?
  mimeType        String
  fileSizeBytes   Int
  width           Int?
  height          Int?
  uploadedById    String?
  uploadedBy      Admin?    @relation(fields: [uploadedById], references: [id])
  // Soft-delete marker — Restrict above already makes a referenced asset
  // impossible to hard-delete via Prisma; this lets "delete" on an
  // unreferenced asset still preserve storageKey/url history instead of
  // losing it outright. Queries should filter deletedAt: null.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  cmsPages  CmsPage[]
  blogPosts BlogPost[]
}

// A fixed set of named, CMS-managed image slots on otherwise-hardcoded
// public pages (homepage hero, the three service-division cards, the "Why
// Moira Events" image, each division page's two image slots) — edited from
// Admin → Pages → Images, not through the generic CmsPage/CmsPageSection
// system, since these are specific, fixed positions on specific existing
// pages rather than freeform page content.
//
// `imageUrl` is a plain external URL, not a MediaAsset reference — there is
// no real upload pipeline yet (lib/media/provider.ts is still a no-op seam,
// Vercel Blob was explicitly deferred pending separate approval/setup), so
// for now an editor pastes a URL to an already-hosted image rather than
// uploading a file directly. Switching this to reference MediaAsset once
// real uploads exist is a natural, non-breaking follow-up (add the column,
// backfill, deprecate imageUrl) — not something to half-build now against
// a storage backend that doesn't exist.
model SiteImageSlot {
  id          String   @id @default(cuid())
  // One of a fixed, known set of keys (see lib/site-images/slots.ts):
  // "home-hero", "home-why-moira", "division-weddings",
  // "division-parties-social-events", "division-corporate-events".
  key         String   @unique
  imageUrl    String?
  // Required by the admin UI whenever imageUrl is set — never optional once
  // there's an actual image for it to describe.
  alt         String?
  // Only shown publicly when it differs from the section's own heading —
  // this field existing and being equal to the heading is treated the same
  // as it being absent (CmsImage's caller decides that comparison).
  caption     String?
  // Percent (0-100) — translated to CSS `object-position` so an editor can
  // keep the subject in frame on a fixed-aspect-ratio crop.
  focalX      Int      @default(50)
  focalY      Int      @default(50)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id])
}

// Fixed-key text overrides for existing, hand-built page copy — the text
// analog of SiteImageSlot above, same shape and same philosophy: a known,
// fixed set of keys (not arbitrary admin-created rows), a nullable value
// (null/absent = no override, the page falls back to its hardcoded
// default in lib/content/*.ts), and the same updatedAt/updatedBy
// attribution. Starts with the five Homepage hero keys
// ("home.hero.eyebrow", "home.hero.headline", "home.hero.body",
// "home.hero.primaryCtaLabel", "home.hero.secondaryCtaLabel" — see
// lib/site-copy/keys.ts); future pages add more keys to this same table,
// never a new model per page.
model SiteCopy {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id])
}

// Public portfolio case studies — a real, admin-editable list (unlike the
// fixed SiteImageSlot keys above). Reuses the existing EventType enum
// (Enquiry/Event) rather than inventing a parallel classification, since
// "which division" is the same concept either way.
model PortfolioItem {
  id          String    @id @default(cuid())
  title       String
  eventType   EventType
  guestCount  Int?
  venueOrCity String?
  story       String?
  imageUrl    String?
  alt         String?
  // Per the explicit rule: an item with neither an image nor a description
  // is not publishable — enforced in lib/site-images/actions.ts, not just
  // documented here.
  published   Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String?
  author      Admin?    @relation(fields: [authorId], references: [id])

  @@index([published])
}

// ============================================================================
// Global site layer (Settings/Navigation/Collections/Redirects) — additive,
// built on top of the existing CMS models above. Site-wide singleton
// configuration, menu/footer structure, and the six reusable content
// collections replacing what was previously hardcoded in lib/content/*.
// Roles/permissions expansion and full i18n were explicitly deferred to
// their own separate passes (owner decision) — nothing here assumes either
// yet: every new model still uses the existing two-role Admin/AdminRole
// system, and every text field is a single plain String (English only).
// ============================================================================

// Deliberately a true singleton: id is always 1 (enforced at the
// application layer in lib/settings/data.ts via an upsert-by-fixed-id
// pattern, not by a DB constraint — Prisma has no native "exactly one row"
// constraint short of a check constraint this project's migration
// convention doesn't otherwise use). One record holds every tab shown in
// /admin/settings (Brand/Contact/Social/CTAs/SEO/Notifications) plus the
// announcement bar, maintenance mode, and cookie-consent text — all
// genuinely singular, site-wide values, not a list of anything.
model SiteSettings {
  id Int @id @default(1)

  // Brand
  siteName   String  @default("Moira Events")
  logoUrl    String?
  faviconUrl String?

  // Contact — phoneE164 stored as the actual E.164 value (e.g.
  // "+250787553323"); the "+250 787 553 323" display form is derived at
  // render time (lib/settings/format.ts), never stored separately, so the
  // two can never drift out of sync.
  phoneE164          String?
  contactEmail       String?
  whatsappNumber     String?
  addressLine        String?
  // No specific city has ever been confirmed for this business (see
  // lib/content/config.ts's own long-standing note) — left optional and
  // empty by default; never defaulted to a fabricated value.
  city               String?
  openingHours       String?
  googleMapsUrl      String?

  // Social
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  linkedinUrl  String?
  youtubeUrl   String?

  // CTAs
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?

  // SEO defaults
  titleTemplate          String  @default("%s | Moira Events")
  defaultMetaDescription String?
  defaultOgImageUrl      String?
  gscVerification        String?
  ga4Id                  String?
  metaPixelId            String?

  // Notifications (per-form recipient + auto-reply)
  quoteRecipientEmail         String?
  consultationRecipientEmail  String?
  contactRecipientEmail       String?
  quoteAutoReplyTemplate      String?
  consultationAutoReplyTemplate String?
  contactAutoReplyTemplate    String?
  whatsappSmsNotifyEnabled    Boolean @default(false)

  // Announcement bar — one at a time, by design (the ticket describes it
  // in the singular); start/end are read, not enforced by a DB constraint,
  // at render time in components/AnnouncementBar.tsx.
  announcementText        String?
  announcementLink        String?
  announcementColor       String?
  announcementStartAt     DateTime?
  announcementEndAt       DateTime?
  announcementDismissible Boolean   @default(true)

  // Maintenance mode — checked in proxy.ts for every public (non-admin,
  // non-portal) request; logged-in staff bypass it (same signed admin
  // cookie proxy.ts already verifies for /admin).
  maintenanceModeEnabled Boolean @default(false)
  maintenanceMessage     String?

  // Cookie consent
  cookieConsentText String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id])
}

enum NavLocation {
  HEADER
  FOOTER
}

// Shared by both the header menu and the footer builder (location
// distinguishes them) and reuses the exact same one-level parent/child
// shape for two different purposes: in HEADER, a top-level item with
// children is a dropdown (e.g. "Our Events"); in FOOTER, a top-level item
// with children is a link column (the column header has no href of its
// own) and a top-level item with no children is a flat link (e.g. a legal
// link placed directly in the footer, not inside a column).
model NavigationItem {
  id        String          @id @default(cuid())
  label     String
  href      String?
  cmsPageId String?
  cmsPage   CmsPage?        @relation(fields: [cmsPageId], references: [id], onDelete: SetNull)
  location  NavLocation
  parentId  String?
  parent    NavigationItem? @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavigationItem[] @relation("NavigationItemChildren")
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([location])
}

// 301 by default (the correct status for "this moved permanently," which
// is the only case lib/cms/actions.ts auto-creates one for — see
// createRedirectForSlugChange). Manually-added redirects may use 302.
// Applied in proxy.ts, checked before any other routing for the public
// site (never for /admin or /portal — an admin mistyping their own URLs
// should see a real 404, not a silently "working" redirect).
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

model Testimonial {
  id                 String     @id @default(cuid())
  clientName         String
  eventType          EventType?
  quote              String
  rating             Int?
  photoUrl           String?
  alt                String?
  featuredOnHomepage Boolean    @default(false)
  published          Boolean    @default(false)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  authorId           String?
  author             Admin?     @relation(fields: [authorId], references: [id])

  @@index([published])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  // Free text (e.g. "contact", "weddings") rather than an enum — the same
  // reasoning as CmsPageSection.type: a closed set here would need a
  // migration every time a new page wants its own FAQ category, for a
  // field that's purely a display-grouping label, not a security boundary.
  category  String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model ServicePackage {
  id               String     @id @default(cuid())
  name             String
  eventType        EventType?
  shortDescription String?
  // Plain string array (Prisma's native Json type, stored as a JSON array
  // of strings) — a fixed list of short bullet points, not structured data
  // that needs its own table.
  inclusions       Json       @default("[]")
  // Minor units (e.g. RWF has no further subdivision in practice, but
  // storing as an integer "from" amount avoids float-precision issues
  // entirely regardless of currency) — optional because not every package
  // has published pricing yet (confirmed elsewhere in this app: "Packages
  // and published pricing are coming soon").
  fromPriceMinor   Int?
  currency         String?    @default("RWF")
  published        Boolean    @default(false)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([published])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String?
  photoUrl  String?
  alt       String?
  bio       String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  alt       String?
  url       String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Stat {
  id        String   @id @default(cuid())
  label     String
  value     String
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}
